load("@rules_cc//cc:defs.bzl", "cc_library")
load("@pico-sdk//bazel:defs.bzl", "pico_generate_pio_header")

cc_library(
    name = "phy_timing",
    hdrs = ["phy_timing.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "tx_level",
    hdrs = ["tx_level.h"],
    visibility = ["//src/phy:__subpackages__"],
)

cc_library(
    name = "phy_stats",
    hdrs = ["phy_stats.h"],
    visibility = ["//visibility:public"],
    deps = ["//src/mac:ethernet_frame"],
)

cc_library(
    name = "rx_frame_recover",
    hdrs = ["rx_frame_recover.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/mac:crc32",
        "//src/mac:ethernet_frame",
    ],
)

cc_library(
    name = "rx_pio_config",
    hdrs = ["rx_pio_config.h"],
    visibility = ["//visibility:public"],
    deps = ["@pico-sdk//src/rp2_common/hardware_pio"],
    target_compatible_with = ["@pico-sdk//bazel/constraint:rp2350"],
)

cc_library(
    name = "rx_slot_ring",
    hdrs = ["rx_slot_ring.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "link_pulse",
    hdrs = ["link_pulse.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":phy_timing",
        "//src/util:random",
    ],
)

cc_library(
    name = "duplex",
    hdrs = ["duplex.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "autoneg",
    hdrs = ["autoneg.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":duplex",
        ":phy_timing",
    ],
)

cc_library(
    name = "link_state",
    hdrs = ["link_state.h"],
    visibility = ["//visibility:public"],
    deps = [":phy_timing"],
)

cc_library(
    name = "csma_cd",
    hdrs = ["csma_cd.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":duplex",
        ":phy_timing",
        "//src/util:random",
    ],
)

pico_generate_pio_header(
    name = "tx_level_pio",
    srcs = ["tx_level.pio"],
    visibility = ["//src/phy:__subpackages__"],
)

pico_generate_pio_header(
    name = "rx_pio",
    srcs = ["rx.pio"],
    visibility = ["//src/phy:__subpackages__"],
)

pico_generate_pio_header(
    name = "carrier_qualify_pio",
    srcs = ["carrier_qualify.pio"],
)

cc_library(
    name = "phy",
    srcs = ["phy.cpp"],
    hdrs = ["phy.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":autoneg",
        ":carrier_qualify_pio",
        ":csma_cd",
        ":duplex",
        ":link_pulse",
        ":link_state",
        ":phy_stats",
        ":phy_timing",
        ":rx_frame_recover",
        ":rx_pio",
        ":rx_pio_config",
        ":rx_slot_ring",
        ":tx_level",
        ":tx_level_pio",
        "//src/mac:ethernet_frame",
        "@pico-sdk//src/rp2_common/hardware_clocks",
        "@pico-sdk//src/rp2_common/hardware_dma",
        "@pico-sdk//src/rp2_common/hardware_gpio",
        "@pico-sdk//src/rp2_common/hardware_pio",
        "@pico-sdk//src/rp2_common/hardware_sync",
        "@pico-sdk//src/rp2_common/pico_stdlib",
    ],
    target_compatible_with = ["@pico-sdk//bazel/constraint:rp2350"],
)
