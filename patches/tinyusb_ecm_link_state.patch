 void tud_network_recv_renew(void) {
   usbd_edpt_xfer(0, _netd_itf.ep_out, _netd_epbuf.rx, NETD_PACKET_SIZE);
@@ -200,7 +201,7 @@
     .header = {
       .bmRequestType = 0xA1,
