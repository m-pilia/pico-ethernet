common --enable_bzlmod
common --check_direct_dependencies=off
common --incompatible_default_to_explicit_init_py

build --copt=-O2
build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=--pedantic
build --cxxopt=-fno-exceptions
build --cxxopt=-fno-rtti
build --cxxopt=-std=c++23
build --cxxopt=-fdiagnostics-color=always

build:dbg --copt=-O0
build:dbg --copt=-g3

# Register toolchains from pico-sdk
build --extra_toolchains=@pico-sdk//bazel/toolchain:linux-x86_64-rp2350

# RP2350 build config
# Use our patched TinyUSB and our TinyUSB config
build:rp2350 --platforms=@pico-sdk//bazel/platform:rp2350
build:rp2350 --@pico-sdk//bazel/config:PICO_TINYUSB_LIB=@patched_tinyusb//:tinyusb
build:rp2350 --@pico-sdk//bazel/config:PICO_TINYUSB_CONFIG=//src/usb:tusb_config
build:rp2350 --aspects @pico-sdk//tools:uf2_aspect.bzl%pico_uf2_aspect
build:rp2350 --output_groups=+pico_uf2_files

# Firmware memory-layout guardrails. Stack-usage budget scoped to first-party
# sources; runtime MPU stack guard; flash/RAM usage report on every link.
build:rp2350 --per_file_copt=src/.*\.cpp$@-Werror=stack-usage=4096
build:rp2350 --copt=-DPICO_USE_STACK_GUARDS=1
build:rp2350 --linkopt=-Wl,--print-memory-usage

build:asan --features=asan
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-g
build:asan --strip=never
build:asan --test_env=ASAN_OPTIONS=halt_on_error=1:detect_leaks=1

build:ubsan --features=ubsan
build:ubsan --copt=-fno-sanitize-recover=all
build:ubsan --copt=-fno-omit-frame-pointer
build:ubsan --copt=-g
build:ubsan --strip=never
build:ubsan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1

build:msan --features=msan
build:msan --copt=-fsanitize-memory-track-origins=2
build:msan --copt=-fno-omit-frame-pointer
build:msan --copt=-g
build:msan --strip=never
build:msan --test_env=MSAN_OPTIONS=halt_on_error=1

build:tidy --aspects=//tools/tidy:tidy.bzl%clang_tidy_aspect
build:tidy --output_groups=report

test --test_output=errors

# Suppress warnings from third party code
build --output_filter='^//'
