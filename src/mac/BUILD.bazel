load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "mac_address",
    hdrs = ["mac_address.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "crc32",
    hdrs = ["crc32.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "ethernet_frame",
    hdrs = ["ethernet_frame.h"],
    visibility = ["//visibility:public"],
    deps = [":mac_address"],
)

cc_library(
    name = "frame_builder",
    hdrs = ["frame_builder.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":crc32",
        ":ethernet_frame",
    ],
)

cc_library(
    name = "frame_filter",
    hdrs = ["frame_filter.h"],
    visibility = ["//visibility:public"],
    deps = [":mac_address"],
)
