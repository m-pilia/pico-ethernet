@@ -398,4 +399,25 @@
   do_in_xfer(_netd_epbuf.tx, len);
 }
 
+// Set ECM link state (up/down) and notify the host via NetworkConnection.
+// The state is recorded even before the interface is open, so it can be set
+// once at init and still apply when the host first queries the connection.
+void tud_network_link_state(uint8_t rhport, bool is_up) {
+  (void) rhport;
+  ecm_link_is_up = is_up;
+  if (!_netd_itf.ecm_mode) {
+    return; // interface not open yet; state applies on the next host query
+  }
+  ecm_notify_t notify = {
+    .header = {
+      .bmRequestType = 0xA1,
+      .bRequest = 0, /* NETWORK_CONNECTION */
+      .wValue = is_up ? 1 : 0,
+      .wLength = 0,
+    },
+  };
+  notify.header.wIndex = _netd_itf.itf_num;
+  netd_report((uint8_t *) &notify, sizeof(notify.header));
+}
