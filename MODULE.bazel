module(
    name = "pico_ethernet",
    version = "0.1.0",
)

# Core build rules
bazel_dep(name = "rules_cc", version = "0.2.17")

# Pico SDK - uses master branch which has Bazel support
bazel_dep(name = "pico-sdk", version = "2.2.0")

# Testing framework - googletest includes googlemock
bazel_dep(name = "googletest", version = "1.17.0")

# Generates compile_commands.json for clangd/IDE tooling. Not on the Bazel
# Central Registry and untagged, so it is pinned to a main-branch commit.
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

# The Pico SDK bundles an older TinyUSB whose NCM driver lacks the link-state
# and Ethernet packet-filter callbacks we rely on. We instead fetch a newer
# upstream TinyUSB that provides tud_network_link_state() and
# tud_network_set_packet_filter_cb() natively, and point PICO_TINYUSB_LIB at it
# (see .bazelrc). The remaining local diffs add a SetEthernetMulticastFilters
# callback and a GetEthernetStatistic handler the NCM driver does not yet expose.
new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

new_git_repository(
    name = "patched_tinyusb",
    build_file = "//patches:tinyusb.BUILD",
    commit = "94d5e74f63d49131d733cc847f1aa71c558101ac",  # upstream master: native link-state + packet-filter callbacks
    patch_args = ["-p1"],
    patches = [
        "//patches:tinyusb_ncm_multicast_filter.patch",
        "//patches:tinyusb_ncm_statistics.patch",
    ],
    remote = "https://github.com/hathach/tinyusb.git",
)
